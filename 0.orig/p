FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        value           uniform 0;
    }

    outlet
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        value           uniform 0;
    }

    farfieldSide
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        value           uniform 0;
    }

    farfieldBottom
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        value           uniform 0;
    }

    farfieldTop
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        value           uniform 0;
    }

    symmetry
    {
        type            symmetryPlane;
    }

    onera
    {
        type            zeroGradient;
    }
}

