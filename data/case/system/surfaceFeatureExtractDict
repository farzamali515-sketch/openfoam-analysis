FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

onera.stl
{
    extractionMethod    extractFromSurface;

    extractFromSurfaceCoeffs
    {
        // Catches the sharp trailing edge and wingtip edge without
        // over-extracting the smooth leading-edge/upper-lower surface.
        includedAngle   150;
    }

    subsetFeatures
    {
        nonManifoldEdges    yes;
        openEdges           yes;
    }

    writeObj    yes;
}

